    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"],
    "paths": {
      "@earendil-works/pi-tui": ["./pi-mcp/node_modules/@earendil-works/pi-tui/dist/index.d.ts"],
      "@earendil-works/pi-agent-core": [
        "./pi-mcp/node_modules/@earendil-works/pi-agent-core/dist/index.d.ts"
